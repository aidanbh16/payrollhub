# PayrollHub development configuration.
# Copy to .env (cp .env.example .env). Every value below is a development-only placeholder.
# .env is gitignored; never commit real credentials or keys.

# --- Data layer (Assignment 5, Section 2.5) ---
# SQLite database file. The .data/ folder is gitignored.
DATABASE_PATH=.data/payrollhub.db

# --- Edge rate limiter store (Assignment 5, Section 2.2) ---
# docker-compose.yml reads REDIS_PASSWORD from this file to start Redis.
# REDIS_URL must use the same password.
REDIS_PASSWORD=dev-only-redis-password-change-me
REDIS_URL=redis://:dev-only-redis-password-change-me@127.0.0.1:6379

# --- Encryption at rest (Assignment 5, Section 3.3; D15) ---
# AES-256-GCM key for routing/account numbers, TOTP secrets, and ACH file bodies.
# Leave empty: npm run setup generates a random 32-byte key into .env.
FIELD_ENCRYPTION_KEY=

# --- Stand-in tenant SSO IdP (D11) ---
# Where the stand-in IdP keeps its per-tenant signing keys and employee directory (written by npm run db:reset).
MOCK_IDP_DIR=.data/mock-idp

# --- Local key store (Assignment 5, Section 2.5; DV-07) ---
# Versioned signing keys (service tokens; later approval tokens and ACH batches). Created by npm run db:reset.
KEYSTORE_DIR=.data/keys

# --- Edge rate limiter (Assignment 5, Section 2.2) ---
# Next.js gives Proxy no client IP that a client cannot forge, so per-IP limits are OFF unless a reverse proxy in front
# of the app overwrites a header with the real client address. Only then set its (lowercase) name here, e.g. x-real-ip.
# TRUSTED_CLIENT_IP_HEADER=
RATE_LIMIT_PREFIX=rl

# --- Internal service calls (D6) ---
# Origin the application layer uses to call its own /api/internal/* routes. Change it if you run on another port.
# Must be a loopback address (127.x.x.x, localhost, [::1]); the server refuses to start otherwise.
INTERNAL_API_ORIGIN=http://127.0.0.1:3000

# --- Stand-in employee email (D13) ---
# Mailboxes that receive bank-change confirmation links and notices (written by npm run db:reset).
MOCK_MAIL_DIR=.data/mock-mail
# Public origin used in links inside those emails.
APP_ORIGIN=http://localhost:3000
# Development credentials for testers (staff logins and TOTP secrets, IdP and random mailbox passwords),
# written by npm run db:reset. Gitignored.
DEV_CREDENTIALS_FILE=.data/dev-credentials.txt

# --- Stand-in originating bank (D12) ---
# Local CA and mTLS certificates (npm run setup creates them).
PKI_DIR=.data/pki
# Where ACH Disbursement sends signed batches (start the bank with npm run bank), and the bank's own data.
BANK_URL=https://localhost:8443
BANK_TIMEOUT_MS=10000
MOCK_BANK_DIR=.data/mock-bank

# --- Log pipeline (D14) ---
# Redacted, structured, append-only log files.
LOG_DIR=.data/logs
