# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values stay local; only the placeholder template is committed
.env
.env.*
!.env.example

# PayrollHub runtime data: SQLite database, signing keys, certificates, logs
/.data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright (browser end-to-end tests); e2e data lives under .data/e2e
/test-results/
/playwright-report/
