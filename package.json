{
  "name": "payrollhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "tsx scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env --conditions=react-server scripts/seed.ts",
    "db:reset": "tsx --env-file=.env --conditions=react-server scripts/reset.ts",
    "test": "vitest run",
    "keys:rotate": "tsx --env-file=.env --conditions=react-server scripts/rotate-key.ts",
    "bank": "tsx --env-file=.env --conditions=react-server scripts/mock-bank.ts",
    "totp": "tsx --env-file=.env --conditions=react-server scripts/totp.ts",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "next": "16.4.2",
    "otplib": "13.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "selfsigned": "5.5.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": false,
    "unrs-resolver": false
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
